{
  "name": "@altius/storage-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL 17 + Apache AGE 1.5 StorageProvider",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "files": ["dist"],
  "license": "Apache-2.0",
  "dependencies": {
    "@altius/observability": "workspace:*",
    "@altius/odl": "workspace:*",
    "@altius/spi": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "vitest": "^3.0.0"
  }
}
