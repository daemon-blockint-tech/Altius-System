{
  "name": "@altius/sdk",
  "version": "0.0.1",
  "description": "Auto-generated TypeScript SDK for Altius",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "odl generate sdk ../../domain-packs/nhs-acute/schema -o .",
    "prebuild": "odl generate sdk ../../domain-packs/nhs-acute/schema -o .",
    "pretypecheck": "odl generate sdk ../../domain-packs/nhs-acute/schema -o .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\"",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@altius/odl": "workspace:*",
    "@types/node": "^22.0.0"
  }
}
