{
  "name": "@altius/sdk",
  "version": "0.0.1",
  "description": "Auto-generated TypeScript SDK for Altius",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node ../odl/dist/cli/index.js generate sdk ../../domain-packs/core/schema ../../domain-packs/nhs-acute/schema ../../domain-packs/aml/schema ../../domain-packs/supply-chain/schema -o .",
    "prebuild": "pnpm run generate",
    "pretypecheck": "pnpm run generate",
    "pretest": "pnpm run generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@altius/odl": "workspace:*",
    "@types/node": "^22.0.0",
    "vitest": "^3.0.0"
  }
}
