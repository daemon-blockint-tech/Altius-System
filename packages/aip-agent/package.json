{
  "name": "@altius/aip-agent",
  "version": "0.0.1",
  "private": true,
  "description": "AIP agent — Deep Agents harness connected to Altius ontology via MCP",
  "type": "module",
  "scripts": {
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
