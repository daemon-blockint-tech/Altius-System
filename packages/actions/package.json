{
  "name": "@altius/actions",
  "version": "0.1.0",
  "private": true,
  "description": "Altius Action Engine - CEL evaluation and action execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@altius/engine": "workspace:*",
    "@altius/observability": "workspace:*",
    "@altius/odl": "workspace:*",
    "@altius/spi": "workspace:*",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@altius/storage-memory": "workspace:*",
    "@types/node": "^22.0.0",
    "vitest": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
