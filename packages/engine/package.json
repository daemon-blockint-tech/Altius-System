{
  "name": "@altius/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Altius Ontology Engine - object lifecycle, validation, and event emission",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:sandbox": "bash scripts/build-sandbox-preload.sh",
    "build:all": "pnpm build && pnpm build:sandbox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "files": ["dist", "scripts/build-sandbox-preload.sh", "src/functions/sandbox-preload.c"],
  "license": "Apache-2.0",
  "dependencies": {
    "@altius/spi": "workspace:*",
    "@altius/odl": "workspace:*",
    "@altius/observability": "workspace:*"
  },
  "devDependencies": {
    "@altius/storage-memory": "workspace:*",
    "@types/node": "^22.0.0",
    "vitest": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
