{
  "name": "@altius/pilot-scenarios",
  "version": "0.0.1",
  "description": "End-to-end pilot scenario tests (MVP Section 7)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "clean": "rm -rf dist coverage"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@altius/spi": "workspace:*",
    "@altius/odl": "workspace:*",
    "@altius/storage-memory": "workspace:*",
    "@altius/actions": "workspace:*",
    "@altius/security": "workspace:*",
    "@altius/sync": "workspace:*",
    "@altius/api": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
